# ================================================================
# opencut 部署配置。用法：cp deploy/env.example deploy/env 并填写
# deploy/env 已 gitignore，会原样上传到服务器 /root/opencut/deploy/env
# 同时承担三个角色：本地 deploy.sh 凭证 / 开发机构建参数 / 服务器容器 env_file
# ================================================================

# ===== 部署目标（本地 deploy.sh 用）=====
# 缺省回退复用 infer-web 的 INFER_W_REMOTE_HOST / INFER_W_REMOTE_PASS
OPENCUT_REMOTE_HOST=154.9.254.162
OPENCUT_REMOTE_PASS=

# ===== CCR 镜像仓库（开发机推送 + 服务器拉取共用）=====
# 与 infer-web 同一账号，密码见 infer-web/deploy/build_push.sh 的 docker login 行
CCR_USERNAME=100022060892
CCR_PASSWORD=

# ===== 对外地址 =====
# 缺省自动推导为 http://<服务器IP>:3100 / :8787，配域名时取消注释改掉。
# 注意：这两个值会烘焙进 web 前端包（NEXT_PUBLIC_*），改动后需重新部署 web 镜像
#OPENCUT_SITE_URL=
#OPENCUT_GATEWAY_URL=

# ===== Web 服务（必填，可用 openssl rand -hex 32 生成）=====
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
SRH_TOKEN=

# ===== Web 可选（博客/音效库，不填用占位）=====
MARBLE_WORKSPACE_KEY=placeholder
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=

# ===== Agent Gateway（必填其一）=====
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
#AGENT_PROVIDER=zhipu
#ZHIPU_API_KEY=
