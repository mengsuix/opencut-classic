{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "style_playbook", "scenes", "metadata", "assumptions", "risks"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "style_playbook": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "description", "start_seconds", "end_seconds", "script_section_id", "framing", "movement", "transition_in", "transition_out", "shot_intent", "narrative_role", "information_role", "hero_moment", "required_assets", "shot_language", "overlay_notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["talking_head", "broll", "animation", "character_scene", "diagram", "text_card", "transition", "generated", "screen_recording"]},
          "description": {"type": "string", "minLength": 1},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "script_section_id": {"type": "string", "minLength": 1},
          "framing": {"type": "string", "minLength": 1},
          "movement": {"type": "string", "minLength": 1},
          "transition_in": {"type": "string", "minLength": 1},
          "transition_out": {"type": "string", "minLength": 1},
          "shot_intent": {"type": "string", "minLength": 1},
          "narrative_role": {"type": "string", "minLength": 1},
          "information_role": {"type": "string", "minLength": 1},
          "hero_moment": {"type": "boolean"},
          "required_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description", "source", "asset_ref", "supplemental_id"],
              "properties": {
                "type": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "source": {"type": "string", "enum": ["provided", "supplemental", "generate", "record", "text"]},
                "asset_ref": {"type": "string"},
                "supplemental_id": {"type": "string"}
              }
            }
          },
          "shot_language": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shot_size", "camera_angle", "notes"],
            "properties": {
              "shot_size": {"type": "string"},
              "camera_angle": {"type": "string"},
              "notes": {"type": "string"}
            }
          },
          "overlay_notes": {"type": "string"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crop_regions", "callout_plan", "speed_plan", "quality_gates"],
      "properties": {
        "crop_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "start_seconds", "end_seconds", "zoom_level", "trigger", "restore_note"],
            "properties": {
              "region": {"type": "string"},
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0},
              "zoom_level": {"type": "string"},
              "trigger": {"type": "string"},
              "restore_note": {"type": "string"}
            }
          }
        },
        "callout_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "target", "start_seconds", "end_seconds", "position", "note"],
            "properties": {
              "type": {"type": "string"},
              "target": {"type": "string"},
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0},
              "position": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        },
        "speed_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "action", "start_seconds", "end_seconds", "reason"],
            "properties": {
              "target": {"type": "string"},
              "action": {"type": "string", "enum": ["realtime", "speed_up", "cut"]},
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0},
              "reason": {"type": "string"}
            }
          }
        },
        "quality_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
