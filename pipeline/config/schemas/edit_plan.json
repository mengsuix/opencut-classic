{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "objective",
    "audience",
    "format",
    "style",
    "cover",
    "target_duration_sec",
    "scenes",
    "voiceover",
    "captions",
    "music",
    "supplemental_assets",
    "end_card",
    "assumptions",
    "risks"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "aspect_ratio", "delivery_notes"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "aspect_ratio": {"type": "string", "minLength": 1},
        "resolution": {"type": "string"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "delivery_notes": {"type": "string", "minLength": 1}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "description"],
      "properties": {
        "labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "asset_refs", "supplemental_asset_refs", "visual_description", "headline", "subheadline", "layout", "treatment", "reason"],
      "properties": {
        "source": {"type": "string", "enum": ["provided_asset", "supplemental_asset", "text_card", "ai_generated"]},
        "asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "supplemental_asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "visual_description": {"type": "string", "minLength": 1},
        "headline": {"type": "string", "minLength": 1},
        "subheadline": {"type": "string"},
        "layout": {"type": "string", "minLength": 1},
        "treatment": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "target_duration_sec": {"type": "number", "minimum": 5, "maximum": 1800},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "start_sec", "end_sec", "purpose", "visual", "camera_motion", "asset_refs", "supplemental_asset_refs", "source_ranges", "on_screen_text", "narration", "transition", "emphasis", "audio"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "exclusiveMinimum": 0},
          "purpose": {"type": "string", "minLength": 1},
          "visual": {"type": "string", "minLength": 1},
          "camera_motion": {"type": "string", "minLength": 1},
          "asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "supplemental_asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "source_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_ref", "source_start_sec", "source_end_sec", "selection_reason"],
              "properties": {
                "asset_ref": {"type": "string", "minLength": 1},
                "source_start_sec": {"type": "number", "minimum": 0},
                "source_end_sec": {"type": "number", "exclusiveMinimum": 0},
                "selection_reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "on_screen_text": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "style", "position"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "style": {"type": "string", "minLength": 1},
                "position": {"type": "string", "minLength": 1}
              }
            }
          },
          "narration": {"type": "string"},
          "transition": {"type": "string", "minLength": 1},
          "emphasis": {"type": "string", "minLength": 1},
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["narration_treatment", "music", "sound_effects", "mix_notes"],
            "properties": {
              "narration_treatment": {"type": "string", "minLength": 1},
              "music": {"type": "string", "minLength": 1},
              "sound_effects": {"type": "array", "items": {"type": "string"}},
              "mix_notes": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "voiceover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "language", "tone", "segments"],
      "properties": {
        "enabled": {"type": "boolean"},
        "language": {"type": "string", "minLength": 1},
        "tone": {"type": "string", "minLength": 1},
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_sec", "end_sec", "text"],
            "properties": {
              "start_sec": {"type": "number", "minimum": 0},
              "end_sec": {"type": "number", "exclusiveMinimum": 0},
              "text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "source", "style", "position", "max_chars_per_line"],
      "properties": {
        "enabled": {"type": "boolean"},
        "source": {"type": "string", "minLength": 1},
        "style": {"type": "string", "minLength": 1},
        "position": {"type": "string", "minLength": 1},
        "max_chars_per_line": {"type": "integer", "minimum": 8, "maximum": 80}
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mood", "source", "ducking_db", "notes"],
      "properties": {
        "required": {"type": "boolean"},
        "mood": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "ducking_db": {"type": "number", "minimum": -60, "maximum": 0},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "supplemental_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposal_id", "kind", "purpose", "description", "acquisition", "priority", "needed_for_scene_ids"],
        "properties": {
          "proposal_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "acquisition": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["must_have", "recommended", "optional"]},
          "needed_for_scene_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "constraints": {"type": "string"}
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_sec", "duration_sec", "headline", "subheadline", "cta", "visual", "asset_refs", "supplemental_asset_refs", "audio"],
      "properties": {
        "start_sec": {"type": "number", "minimum": 0},
        "duration_sec": {"type": "number", "exclusiveMinimum": 0},
        "headline": {"type": "string", "minLength": 1},
        "subheadline": {"type": "string"},
        "cta": {"type": "string", "minLength": 1},
        "visual": {"type": "string", "minLength": 1},
        "asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "supplemental_asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "audio": {"type": "string", "minLength": 1}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
