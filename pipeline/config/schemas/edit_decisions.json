{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cuts", "overlays", "audio", "subtitles", "transitions", "renderer_family", "render_runtime", "delivery_promise", "end_card", "metadata", "assumptions", "risks"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "cuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scene_id", "source_type", "source", "in_seconds", "out_seconds", "timeline_start", "timeline_end", "speed", "layer", "transform", "transition_in", "transition_out", "transition_duration", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scene_id": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "enum": ["provided", "supplemental", "generate", "record", "text"]},
          "source": {"type": "string", "minLength": 1},
          "in_seconds": {"type": "number", "minimum": 0},
          "out_seconds": {"type": "number", "exclusiveMinimum": 0},
          "timeline_start": {"type": "number", "minimum": 0},
          "timeline_end": {"type": "number", "exclusiveMinimum": 0},
          "speed": {"type": "number", "minimum": 0.1},
          "layer": {"type": "string", "enum": ["primary", "overlay", "background"]},
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scale", "position", "notes"],
            "properties": {
              "scale": {"type": ["number", "null"]},
              "position": {"type": "string"},
              "notes": {"type": "string"}
            }
          },
          "transition_in": {"type": "string"},
          "transition_out": {"type": "string"},
          "transition_duration": {"type": "number", "minimum": 0},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target", "start_seconds", "end_seconds", "position", "animation", "opacity"],
        "properties": {
          "type": {"type": "string"},
          "target": {"type": "string"},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "position": {"type": "string"},
          "animation": {"type": "string"},
          "opacity": {"type": "string"}
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration", "music", "sound_effects", "ducking"],
      "properties": {
        "narration": {"type": "string"},
        "music": {"type": "string"},
        "sound_effects": {"type": "string"},
        "ducking": {"type": "string"}
      }
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "position", "notes"],
      "properties": {
        "style": {"type": "string"},
        "position": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "at_seconds", "duration_seconds", "notes"],
        "properties": {
          "type": {"type": "string"},
          "at_seconds": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": ["number", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "renderer_family": {"type": "string"},
    "render_runtime": {"type": "string", "enum": ["remotion", "hyperframes", "ffmpeg", "not_selected"]},
    "delivery_promise": {"type": "string", "minLength": 1},
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "subheadline", "cta", "visual", "audio"],
      "properties": {
        "headline": {"type": "string"},
        "subheadline": {"type": "string"},
        "cta": {"type": "string"},
        "visual": {"type": "string"},
        "audio": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crop_keyframes", "speed_plan", "subtitle_position_overrides", "audio_notes", "variant_notes", "quality_gates"],
      "properties": {
        "crop_keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_seconds", "end_seconds", "region", "reason"],
            "properties": {
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0},
              "region": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "speed_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "action", "start_seconds", "end_seconds", "reason"],
            "properties": {
              "target": {"type": "string"},
              "action": {"type": "string", "enum": ["realtime", "speed_up", "cut"]},
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0},
              "reason": {"type": "string"}
            }
          }
        },
        "subtitle_position_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_seconds", "end_seconds", "position", "reason"],
            "properties": {
              "start_seconds": {"type": "number", "minimum": 0},
              "end_seconds": {"type": "number", "exclusiveMinimum": 0},
              "position": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "audio_notes": {"type": "array", "items": {"type": "string"}},
        "variant_notes": {"type": "array", "items": {"type": "string"}},
        "quality_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
