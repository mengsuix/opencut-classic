{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "total_duration_seconds", "voice_performance", "sections", "factual_notes", "assumptions", "risks"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "total_duration_seconds": {"type": "number", "minimum": 1},
    "voice_performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performance_intent", "pacing_profile", "energy_curve", "pause_policy", "sample_section_id", "provider_notes"],
      "properties": {
        "performance_intent": {"type": "string", "minLength": 1},
        "pacing_profile": {"type": "string", "enum": ["contemplative", "conversational", "energetic", "technical", "cinematic", "custom"]},
        "energy_curve": {"type": "string", "minLength": 1},
        "pause_policy": {"type": "string", "minLength": 1},
        "sample_section_id": {"type": "string"},
        "provider_notes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "voice", "notes"],
          "properties": {
            "provider": {"type": "string"},
            "voice": {"type": "string"},
            "notes": {"type": "string"}
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "text", "start_seconds", "end_seconds", "speaker_directions", "delivery_cues", "enhancement_cues", "source_basis", "source_ref", "pronunciation_guides"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "speaker_directions": {"type": "string"},
          "delivery_cues": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pace", "emphasis", "notes"],
            "properties": {
              "pace": {"type": "string"},
              "emphasis": {"type": "string"},
              "notes": {"type": "string"}
            }
          },
          "enhancement_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description", "timestamp_seconds"],
              "properties": {
                "type": {"type": "string", "enum": ["overlay", "broll", "diagram", "stat_card", "code_snippet", "animation", "screen_recording"]},
                "description": {"type": "string", "minLength": 1},
                "timestamp_seconds": {"type": ["number", "null"]}
              }
            }
          },
          "source_basis": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string"},
          "pronunciation_guides": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "pronunciation"],
              "properties": {
                "term": {"type": "string"},
                "pronunciation": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "factual_notes": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
