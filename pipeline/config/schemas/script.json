{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "total_duration_seconds", "voice_performance", "sections", "factual_notes"],
  "properties": {
    "version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "total_duration_seconds": {"type": "number", "minimum": 1},
    "voice_performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performance_intent", "pacing_profile", "energy_curve", "pause_policy"],
      "properties": {
        "performance_intent": {"type": "string", "minLength": 1},
        "pacing_profile": {"type": "string", "enum": ["contemplative", "conversational", "energetic", "technical", "cinematic", "custom"]},
        "energy_curve": {"type": "string", "minLength": 1},
        "pause_policy": {"type": "string", "minLength": 1},
        "sample_section_id": {"type": "string"},
        "provider_notes": {"type": "object"}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "text", "start_seconds", "end_seconds", "speaker_directions", "delivery_cues", "enhancement_cues", "source_basis"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "speaker_directions": {"type": "string"},
          "delivery_cues": {"type": "object"},
          "enhancement_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description"],
              "properties": {
                "type": {"type": "string", "enum": ["overlay", "broll", "diagram", "stat_card", "code_snippet", "animation", "screen_recording"]},
                "description": {"type": "string", "minLength": 1},
                "timestamp_seconds": {"type": "number", "minimum": 0}
              }
            }
          },
          "source_basis": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string"},
          "pronunciation_guides": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "factual_notes": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
