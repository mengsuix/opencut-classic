{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "files", "summary", "planning_implications", "reference_policy"],
  "properties": {
    "version": {"const": "1.0"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "path", "media_type", "reviewed", "reference_role", "reuse_policy", "technical_probe", "content_summary", "representative_frames", "quality_risks", "usable_for"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "media_type": {"enum": ["video", "audio", "image", "document", "text", "archive", "unknown"]},
          "reviewed": {"const": true},
          "reference_role": {"type": "string", "minLength": 1},
          "reuse_policy": {"type": "string", "enum": ["optional_reuse", "style_reference_only", "not_reusable"]},
          "technical_probe": {"type": "object"},
          "content_summary": {"type": "string", "minLength": 1},
          "transcript_summary": {"type": "string"},
          "representative_frames": {"type": "array", "items": {"type": "string"}},
          "quality_risks": {"type": "array", "items": {"type": "string"}},
          "usable_for": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "planning_implications": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_role", "reuse_rule"],
      "properties": {
        "default_role": {"const": "reference_material"},
        "reuse_rule": {"type": "string", "minLength": 1}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
